# ---------------------------------------------------------------------------
# FocusFeed environment (copy to .env; never commit .env)
# Every value below is safe to share. Real secrets must be generated locally.
# ---------------------------------------------------------------------------

# Mode: test | demo | live
#   test  -> deterministic fixtures + fake model, used by automated tests
#   demo  -> labelled synthetic content through the real API/DB/job flow
#   live  -> real platform adapters via a paired local collector + configured model provider
FF_MODE=demo

# Environment: development | production. Production rejects insecure defaults.
FF_ENV=development

# Secret used to derive CSRF tokens and sign enrollment codes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FF_SECRET_KEY=change-me-development-only

# PostgreSQL (psycopg v3 driver). Docker Compose exposes 5432 on the host.
# Inside a container, use host "db" (service name); on the Windows host use "localhost".
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/focusfeed
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/focusfeed_test

# Web origin allowed by CORS/CSRF. Comma-separated. Mobile apps use bearer tokens, not cookies.
FF_ALLOWED_ORIGINS=http://localhost:3000

# Cookie settings: set FF_COOKIE_SECURE=true behind HTTPS (required in production).
FF_COOKIE_SECURE=false
FF_SESSION_TTL_HOURS=168

# ---- AI providers ----------------------------------------------------------
# fake   -> deterministic provider (tests/demo). ollama -> local Ollama.
FF_LLM_PROVIDER=fake
# From a Docker container reaching Ollama on the Windows host use http://host.docker.internal:11434
# From the Windows host itself use http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# Administrator-approved model profiles (users choose among these only)
FF_TEXT_MODELS=qwen2.5:7b-instruct,llama3.2:3b
FF_EMBEDDING_MODELS=nomic-embed-text
FF_VISION_MODELS=
FF_DEFAULT_TEXT_MODEL=qwen2.5:7b-instruct
FF_DEFAULT_EMBEDDING_MODEL=nomic-embed-text
# Longer bounded timeouts for heavier local models (seconds)
FF_MODEL_TIMEOUT_SECONDS=180
# Max concurrent model calls (worker). Keep 1 on an 8-10 GB GPU.
FF_MODEL_CONCURRENCY=1
# External providers are disabled by default and require explicit user disclosure.
FF_EXTERNAL_PROVIDERS_ENABLED=false

# ---- Worker ----------------------------------------------------------------
FF_WORKER_POLL_SECONDS=2
FF_JOB_LEASE_SECONDS=120
FF_RETENTION_DAYS=30

# ---- Collector (runs on the user's own machine) -----------------------------
# The collector talks *outbound* to the API only. Never expose a debugging port.
FF_API_BASE_URL=http://localhost:8000
FF_COLLECTOR_PROFILE_DIR=.focusfeed/profiles
FF_COLLECTOR_POLL_SECONDS=5

# ---- Media tools (optional) --------------------------------------------------
# Caption extraction uses yt-dlp if present on PATH; frame sampling uses ffmpeg.
FF_ENABLE_YTDLP=false
FF_ENABLE_FFMPEG=false

# ============================================================================
# Phase 2 — multiple AI providers, hosted collection, watches, WhatsApp, mail
# All defaults are safe for development. Production refuses insecure combinations.
# ============================================================================

# ---- Credential vault (BYOK and operator-stored keys) -------------------------
# Versioned AES-256-GCM keys kept OUTSIDE the database (env/secret store of API+worker only).
# Generate: python -c "import base64,secrets; print('v1:'+base64.b64encode(secrets.token_bytes(32)).decode())"
# Rotation: append ",v2:<new>" and move FF_CREDENTIAL_ACTIVE_KEY to v2. Required in production.
FF_CREDENTIAL_KEYS=
FF_CREDENTIAL_ACTIVE_KEY=v1

# ---- Providers offered to consumers ------------------------------------------
# Comma-separated ids: ollama, openai, anthropic, gemini, xai (fake is test-only).
FF_ENABLED_PROVIDERS=ollama
FF_CONSUMER_DEFAULT_PROVIDER=
FF_BYOK_ENABLED=true
# Operator keys (consumers never see these). Alternatively store them through the admin API.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Optional catalog override (JSON file; model ids/prices are data, not code)
FF_MODEL_CATALOG_PATH=

# ---- Quotas and spending guard (application estimates, not provider billing caps) ----
FF_DAILY_TOKEN_QUOTA_DEFAULT=200000
FF_DAILY_CALL_QUOTA_DEFAULT=200
FF_DAILY_MESSAGE_QUOTA_DEFAULT=20
FF_DAILY_SPEND_GUARD_USD=5.0
FF_STRICT_COST_GUARD=false

# ---- Hosted (always-on) collection ------------------------------------------
FF_HOSTED_COLLECTION_ENABLED=true
# Private directory with one 0700 profile per user and platform. Never shared, never exposed.
FF_HOSTED_PROFILES_DIR=.focusfeed/hosted-profiles
FF_CONNECT_SESSION_TTL_MINUTES=10
FF_CONNECT_FRAME_MAX_BYTES=150000

# ---- Topic watches ------------------------------------------------------------
FF_WATCH_POLL_MINUTES_DEFAULT=15
# Public URL of the web app (deep links in messages/mails)
FF_PUBLIC_APP_URL=http://localhost:3000

# ---- Account recovery mail -----------------------------------------------------
# disabled -> operator resets passwords; capture -> dev/tests only; smtp -> real delivery
FF_MAIL_MODE=disabled
FF_SMTP_HOST=
FF_SMTP_PORT=587
FF_SMTP_USERNAME=
FF_SMTP_PASSWORD=
FF_SMTP_FROM=
FF_SMTP_STARTTLS=true
FF_RECOVERY_CODE_TTL_MINUTES=15
FF_RATE_LIMIT_RECOVERY_PER_HOUR=5

# ---- WhatsApp Business Platform (Cloud API) — official integration only -----------
# disabled | mock (dev/tests, no network) | live (requires every WA_* secret below)
FF_WHATSAPP_MODE=disabled
# Graph API version: confirm against Meta's current docs at deployment time.
WA_API_VERSION=v23.0
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Display number digits for wa.me deep links (e.g. 15551234567)
WA_BUSINESS_PHONE_E164=
# Comma-separated wa_ids allowed to receive messages during live tests
WA_TEST_RECIPIENTS=
WA_MAX_DELIVERY_AGE_HOURS=12
WA_SERVICE_WINDOW_HOURS=24
